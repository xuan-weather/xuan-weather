{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Immediate","severity":"Moderate","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-10-24T09:15:00+08:00","onset":"2026-10-24T09:15:00+08:00","expires":"2026-10-24T13:15:00+08:00","senderName":"中央氣象署","headline":"海上陸上颱風警報","description":{"section":[{"title":"命名與位置","value":"中度颱風 薔琵（國際命名 CHAMPI）24日9時的中心位置在北緯 25.2 度，東經 123.2 度，即在宜蘭的東北東方約 150 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 965 百帕，近中心最大風速每秒 35 公尺（約每小時 126 公里），相當於 12 級風，瞬間最大陣風每秒 45 公尺（約每小時 162 公里），相當於 14 級風，七級風暴風半徑 250 公里，十級風暴風半徑 80 公里。"},{"title":"移速與預測","value":"以每小時21公里速度，向北轉東北進行，預測25日8時的中心位置在北緯 29.3 度，東經 124.4 度，即在宜蘭的北北東方約 570 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第29號颱風過去3小時強度減弱且暴風圈亦縮小，目前中心在宜蘭東北東方海面，向北轉東北移動，彰化以南已脫離其暴風圈，對臺中以北、南投、宜蘭、花蓮、臺東仍構成威脅，未來颱風強度仍有減弱且暴風圈縮小的趨勢。"},{"title":"警戒區域及事項","value":"海上：臺灣北部海面、臺灣海峽北部、臺灣東半部海面航行及作業船隻應嚴加戒備。陸上：新北、基隆、臺北、桃園、新竹、苗栗、臺中、南投、宜蘭、花蓮、臺東應嚴加戒備。"},{"title":"豪雨特報","value":"第29號颱風及其外圍環流影響，宜蘭縣山區已有超大豪雨，桃園市山區已有大豪雨，今(24)日臺北市、新北市、桃園市、新竹縣、苗栗縣山區仍有局部大雨或豪雨發生的機率，臺中以北、南投、宜蘭、臺南地區及雲林以南山區有局部大雨發生的機率，請注意瞬間大雨，山區請慎防坍方、落石、土石流，低窪地區請慎防積淹水，應避免前往山區及溪流活動。"},{"title":"強風特報","value":"颱風及其外圍環流影響，今(24)日蘭嶼、綠島、屏東縣局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，基隆市、新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、南投縣、彰化縣、雲林縣、嘉義縣、臺南市、高雄市、宜蘭縣、花蓮縣、臺東縣、澎湖縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。下午起蘭嶼、綠島、屏東縣風力稍減弱。"},{"title":"注意事項","value":"＊今(24)日臺灣附近各海面風浪偏大，有2至3公尺以上大浪，尤其基隆北海岸上午前仍有6公尺左右巨浪；臺灣各沿海及蘭嶼、綠島、澎湖、馬祖有長浪發生，請避免前往海邊活動。＊室外懸掛物、招牌、圍籬及鷹架等應加強固牢，陽台之盆景等應妥善放置。＊高溫資訊：颱風環流沉降影響，臺東縣已有長時間焚風發生，花蓮地區亦有焚風，今(24)日臺東縣為橙色燈號，有38度極端高溫；花蓮縣為黃色燈號，請注意。＊22日0時至24日9時出現較大雨量如下：宜蘭縣太平山(1)652毫米，新竹縣鳥嘴山490毫米，桃園市拉拉山445.5毫米，苗栗縣拉庫斯424.5毫米，臺中市南湖圈谷423.5毫米，新北市熊空山373毫米，臺北市擎天崗328毫米，嘉義縣獨立山313毫米，雲林縣草嶺308毫米，南投縣臺大溪頭283.5毫米，花蓮縣和平林道278.5毫米，臺南市大棟山227毫米；出現較大陣風區域如下：蘭嶼15級，彭佳嶼、基隆14級，蘇澳13級，宜蘭、花蓮、東吉島12級，成功11級，新屋、澎湖10級。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"20-1"},{"title":"警報類別","value":"LAND"},{"title":"颱風編號","value":"29"},{"title":"颱風資訊","analysis":{"time":"2026-10-24T01:00:00+00:00","position":"25.20,123.20","gust":{"value":"45","unit":"m/s"},"pressure":{"value":"965","unit":"hPa"},"scale":[{"value":"中度颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"35","unit":"m/s"},"radius_of_15mps":{"value":"250","unit":"km"}},"prediction":{"time":"2026-10-25T00:00:00+00:00","position":"29.30,124.40","gust":{"value":"30","unit":"m/s"},"pressure":{"value":"988","unit":"hPa"},"max_winds":{"value":"23","unit":"m/s"},"radius_of_15mps":{"value":"180","unit":"km"}},"typhoon_name":"CHAMPI","cwa_typhoon_name":"薔琵"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上陸上颱風警報"},{"valueName":"alert_color","value":"紅色"},{"valueName":"website_color","value":"255,0,0"}],"area":[{"areaDesc":"臺灣北部海面","polygon":"25.000032,122.000000 25.000032,121.997200 25.006732,122.000000 25.114732,121.881700 25.126532,121.788600 25.138932,121.734700 25.168632,121.681300 25.214432,121.636700 25.249432,121.616900