均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。"},{"title":"注意事項","value":"＊今(21日)晚至明(22)日基隆北海岸、東半部沿海(含蘭嶼、綠島)及恆春半島、馬祖易有長浪發生；臺灣附近各海面風浪逐漸增大，有3公尺以上大浪，尤其東半部(含蘭嶼、綠島)沿海易有6公尺以上巨浪，請避免前往海邊活動。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"1"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"29"},{"title":"颱風資訊","analysis":{"time":"2026-10-21T15:00:00+00:00","position":"19.50,127.40","gust":{"value":"68","unit":"m/s"},"pressure":{"value":"910","unit":"hPa"},"scale":[{"value":"強烈颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"55","unit":"m/s"},"radius_of_15mps":{"value":"280","unit":"km"}},"prediction":{"time":"2026-10-22T15:00:00+00:00","position":"21.50,124.80","gust":{"value":"63","unit":"m/s"},"pressure":{"value":"925","unit":"hPa"},"max_winds":{"value":"51","unit":"m/s"},"radius_of_15mps":{"value":"300","unit":"km"}},"typhoon_name":"CHAMPI","cwa_typhoon_name":"薔琵"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"巴士海峽東部","polygon":"20.000032,121.500000 20.000032,121.000000 20.500032,121.000000 21.000032,121.000000 21.500032,121.000000 22.000032,121.000000 22.000032,121.500000 22.000032,122.000000 22.000032,122.500000 22.000032,123.000000 21.500032,123.000000 21.000032,123.000000 20.500032,123.000000 20.000032,123.000000 20.000032,122.500000 20.000032,122.000000 20.000032,121.500000"},{"areaDesc":"臺灣東北部海面","polygon":"23.500032,122.000000 23.500032,121.500000 23.701432,121.536900 23.900032,121.596400 23.983332,121.611400 24.000032,121.612900 24.000032,122.000000 24.000032,122.500000 24.000032,123.000000 23.500032,123.000000 23.500032,122.500000 23.500032,122.000000"},{"areaDesc":"臺灣東南部海面","polygon":"22.000032,121.500000 22.000032,121.000000 22.000032,120.862100 22.036932,120.881400 22.098032,120.884700 22.232532,120.87940