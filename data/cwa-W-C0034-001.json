{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Future","severity":"Minor","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-10-22T05:30:00+08:00","onset":"2026-10-22T05:30:00+08:00","expires":"2026-10-22T09:30:00+08:00","senderName":"中央氣象署","headline":"海上颱風警報","description":{"section":[{"title":"命名與位置","value":"強烈颱風 薔琵（國際命名 CHAMPI）22日5時的中心位置在北緯 20.1 度，東經 126.4 度，即在鵝鑾鼻的東南東方約 610 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 925 百帕，近中心最大風速每秒 51 公尺（約每小時 184 公里），相當於 16 級風，瞬間最大陣風每秒 63 公尺（約每小時 227 公里），相當於 17 級風以上，七級風暴風半徑 280 公里，十級風暴風半徑 140 公里。"},{"title":"移速與預測","value":"以每小時13轉16公里速度，向西北轉北北西進行，預測23日5時的中心位置在北緯 22.3 度，東經 124.0 度，即在鵝鑾鼻的東方約 330 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第29號颱風過去3小時強度略為減弱，中心目前在鵝鑾鼻東南東方海面，向西北轉北北西移動，對巴士海峽、臺灣東半部海面及臺灣北部海面構成威脅。"},{"title":"警戒區域及事項","value":"海上：巴士海峽、臺灣東北部海面、臺灣東南部海面(含蘭嶼、綠島)及臺灣北部海面航行及作業船隻應嚴加戒備。"},{"title":"強風特報","value":"颱風外圍環流影響及東北風明顯偏強，今(22)日蘭嶼、綠島、彰化縣、雲林縣、澎湖縣局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、嘉義縣、臺南市、高雄市、屏東縣、宜蘭縣、花蓮縣、臺東縣、金門縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。"},{"title":"注意事項","value":"＊今(22)日基隆北海岸、東半部沿海(含蘭嶼、綠島)及恆春半島、馬祖易有長浪發生；臺灣附近各海面風浪偏大，有3公尺以上大浪，尤其東半部(含蘭嶼、綠島)沿海及基隆北海岸、恆春半島易有6公尺以上巨浪，請避免前往海邊活動。＊室外懸掛物、招牌、圍籬及鷹架等應加強固牢，陽台之盆景等應妥善放置。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"3"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"29"},{"title":"颱風資訊","analysis":{"time":"2026-10-21T21:00:00+00:00","position":"20.10,126.40","gust":{"value":"63","unit":"m/s"},"pressure":{"value":"925","unit":"hPa"},"scale":[{"value":"強烈颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"51","unit":"m/s"},"radius_of_15mps":{"value":"280","unit":"km"}},"prediction":{"time":"2026-10-22T21:00:00+00:00","position":"22.30,124.00","gust":{"value":"58","unit":"m/s"},"pressure":{"value":"930","unit":"hPa"},"max_winds":{"value":"48","unit":"m/s"},"radius_of_15mps":{"value":"300","unit":"km"}},"typhoon_name":"CHAMPI","cwa_typhoon_name":"薔琵"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"巴士海峽東部","polygon":"20.000032,121.500000 20.000032,121.000000 20.500032,121.000000 21.000032,121.000000 21.500032,121.000000 22.000032,121.000000 22.000032,121.500000 22.000032,122.000000 22.000032,122.500000 22.000032,123.000000 21.500032,123.000000 21.000032,123.000000 20.500032,123.000000 20.000032,123.000000 20.000032,122.500000 20.000032,122.000000 20.000032,121.500000"},{"areaDesc":"臺灣北部海面","polygon":"25.000032,122.000000 25.000032,121.997200 25.006732,122.000000 25.114732,121.881700 25.126532,121.788600 25.138932,121.734700 25.168632,121.681300 25.214432,121.636700 25.249432,121.616900 25.259132,121.608900 25.267232,121.598000 25.275832,121.583300 25.283632,121.563200 25.282232,121.515300 25.277332,121.500000 25.270432,121.478300 25.243932,121.4427