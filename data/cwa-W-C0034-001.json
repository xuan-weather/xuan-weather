{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Immediate","severity":"Moderate","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-10-24T14:30:00+08:00","onset":"2026-10-24T14:30:00+08:00","expires":"2026-10-24T18:30:00+08:00","senderName":"中央氣象署","headline":"海上颱風警報","description":{"section":[{"title":"命名與位置","value":"輕度颱風 薔琵（國際命名 CHAMPI）24日14時的中心位置在北緯 26.8 度，東經 123.2 度，即在臺北的東北方約 260 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 975 百帕，近中心最大風速每秒 30 公尺（約每小時 108 公里），相當於 11 級風，瞬間最大陣風每秒 38 公尺（約每小時 137 公里），相當於 13 級風，七級風暴風半徑 200 公里，十級風暴風半徑 70 公里。"},{"title":"移速與預測","value":"以每小時18轉21公里速度，向北北東轉東北進行，預測25日14時的中心位置在北緯 30.2 度，東經 125.3 度，即在臺北的北北東方約 680 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第29號颱風已減弱為輕度颱風，暴風圈亦縮小，目前中心在臺北東北方海面，向北北東轉東北移動，臺灣本島已脫離其暴風圈，對臺灣北部及東北部海面仍構成威脅，未來颱風強度仍有減弱且暴風圈縮小的趨勢。"},{"title":"警戒區域及事項","value":"海上：臺灣北部海面、臺灣東北部海面航行及作業船隻應嚴加戒備。"},{"title":"豪雨特報","value":"第29號颱風及其外圍環流影響，宜蘭縣山區已有超大豪雨，桃園市山區已有大豪雨，今(24)日臺北市、新北市、桃園市、新竹縣、苗栗縣山區仍有局部大雨或豪雨發生的機率，臺中以北、南投、宜蘭、臺南地區及雲林以南山區有局部大雨發生的機率，請注意瞬間大雨，山區請慎防坍方、落石、土石流，低窪地區請慎防積淹水，應避免前往山區及溪流活動。"},{"title":"強風特報","value":"颱風及其外圍環流影響，今(24)日蘭嶼、綠島局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，基隆市、新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、南投縣、彰化縣、雲林縣、嘉義縣、臺南市、高雄市、屏東縣、宜蘭縣、花蓮縣、臺東縣、澎湖縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。下午起蘭嶼、綠島風力稍減弱。"},{"title":"注意事項","value":"＊今(24)日臺灣附近各海面風浪仍偏大，北部、東北部沿海及馬祖仍有3至5公尺大浪，其他各海面亦有2公尺以上浪高；臺灣各沿海及蘭嶼、綠島、澎湖、馬祖有長浪發生，請避免前往海邊活動。＊高溫資訊：颱風環流沉降影響，臺東縣已有長時間焚風發生，花蓮地區亦有焚風，今(24)日臺東縣為橙色燈號，有38度極端高溫；花蓮縣為黃色燈號，請注意。＊22日0時至24日14時出現較大雨量如下：宜蘭縣太平山(1)650毫米，新竹縣鳥嘴山531毫米，桃園市東眼山491.5毫米，苗栗縣拉庫斯464毫米，新北市熊空山443毫米，臺中市南湖圈谷424毫米，臺北市陽明山421.5毫米，嘉義縣獨立山319.5毫米，雲林縣草嶺(2)317毫米，南投縣臺大溪頭301.5毫米，花蓮縣和平林道278.5毫米，臺南市大棟山241.5毫米；出現較大陣風區域如下：蘭嶼15級，彭佳嶼、基隆14級，蘇澳13級，宜蘭、花蓮、東吉島12級，成功11級，新屋、澎湖10級。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"22"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"29"},{"title":"颱風資訊","analysis":{"time":"2026-10-24T06:00:00+00:00","position":"26.80,123.20","gust":{"value":"38","unit":"m/s"},"pressure":{"value":"975","unit":"hPa"},"scale":[{"value":"輕度颱風","lang":"zh-TW"},{"value":"SEVERE TROPICAL STORM","lang":"en"}],"max_winds":{"value":"30","unit":"m/s"},"radius_of_15mps":{"value":"200","unit":"km"}},"prediction":{"time":"2026-10-25T06:00:00+00:00","position":"30.20,125.30","gust":{"value":"28","unit":"m/s"},"pressure":{"value":"995","unit":"hPa"},"max_winds":{"value":"20","unit":"m/s"},"radius_of_15mps":{"value":"150","unit":"km"}},"typhoon_name":"CHAMPI","cwa_typhoon_name":"薔琵"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"臺灣北部海面","polygon":"25.000032,122.000000 25.000032,121.997200 25.006732,122.000000 25.114732,121.881700 25.126532,121.788600 25.138932,121.734700 25.168632,121.681300 25.214432,121.636700 25.249432,121.616900 25.259132,121.608900 25.267232,121.598000 25.275832,121.583300 2