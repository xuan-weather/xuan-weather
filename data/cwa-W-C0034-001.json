{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Expected","severity":"Moderate","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-10-22T18:15:00+08:00","onset":"2026-10-22T18:15:00+08:00","expires":"2026-10-22T22:15:00+08:00","senderName":"中央氣象署","headline":"海上陸上颱風警報","description":{"section":[{"title":"命名與位置","value":"中度颱風 薔琵（國際命名 CHAMPI）22日18時的中心位置在北緯 21.1 度，東經 125.0 度，即在鵝鑾鼻的東方約 440 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 930 百帕，近中心最大風速每秒 48 公尺（約每小時 173 公里），相當於 15 級風，瞬間最大陣風每秒 58 公尺（約每小時 209 公里），相當於 17 級風，七級風暴風半徑 320 公里，十級風暴風半徑 160 公里。"},{"title":"移速與預測","value":"以每小時18公里速度，向西北轉北北西進行，預測23日17時的中心位置在北緯 24.1 度，東經 122.9 度，即在宜蘭的東南東方約 140 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第29號颱風過去3小時強度稍減弱，中心目前在鵝鑾鼻東方海面，向西北轉北北西移動，對臺灣陸地將構成威脅。"},{"title":"警戒區域及事項","value":"海上：臺灣附近各海面及巴士海峽航行作業船隻應嚴加戒備。陸上：臺灣各地區應嚴加戒備，並防強風豪雨。"},{"title":"大雨特報","value":"東北季風及第29號颱風外圍環流影響，易有短延時強降雨，今(22)日基隆北海岸、桃園以北及宜蘭地區有局部大雨發生的機率，低窪地區請慎防積水。"},{"title":"強風特報","value":"今(22)日東北風明顯偏強及颱風外圍環流影響，明(23)日颱風及其外圍環流影響，基隆市、新北市、桃園市、新竹市、苗栗縣、臺中市、彰化縣、雲林縣、嘉義縣、臺南市、高雄市、屏東縣、宜蘭縣、臺東縣(含蘭嶼、綠島)、澎湖縣局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，臺北市、新竹縣、南投縣、嘉義市、花蓮縣、金門縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。"},{"title":"注意事項","value":"＊今明(22、23)兩天臺灣附近各海面風浪偏大，有3公尺以上大浪，尤其東半部(含蘭嶼、綠島)沿海及基隆北海岸、恆春半島易有6公尺以上巨浪；基隆北海岸、中部以北、東半部沿海(含蘭嶼、綠島)及恆春半島、澎湖、馬祖並有長浪發生，請避免前往海邊活動。＊室外懸掛物、招牌、圍籬及鷹架等應加強固牢，陽台之盆景等應妥善放置。＊高溫資訊：颱風環流沉降影響，明、後(23、24)兩天東南部地區有焚風發生的機率，明晚起東部地區亦有焚風發生的機率，23日、24日花蓮縣、臺東縣為黃色燈號，請注意。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"7-1"},{"title":"警報類別","value":"LAND"},{"title":"颱風編號","value":"29"},{"title":"颱風資訊","analysis":{"time":"2026-10-22T10:00:00+00:00","position":"21.10,125.00","gust":{"value":"58","unit":"m/s"},"pressure":{"value":"930","unit":"hPa"},"scale":[{"value":"中度颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"48","unit":"m/s"},"radius_of_15mps":{"value":"320","unit":"km"}},"prediction":{"time":"2026-10-23T09:00:00+00:00","position":"24.10,122.90","gust":{"value":"58","unit":"m/s"},"pressure":{"value":"930","unit":"hPa"},"max_winds":{"value":"48","unit":"m/s"},"radius_of_15mps":{"value":"320","unit":"km"}},"typhoon_name":"CHAMPI","cwa_typhoon_name":"薔琵"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上陸上颱風警報"},{"valueName":"alert_color","value":"紅色"},{"valueName":"website_color","value":"255,0,0"}],"area":[{"areaDesc":"巴士海峽東部","polygon":"20.000032,121.500000 20.000032,121.000000 20.500032,121.000000 21.000032,121.000000 21.500032,121.000000 22.000032,121.000000 22.000032,121.500000 22.000032,122.000000 22.000032,122.500000 22.000032,123.000000 21.500032,123.000000 21.000032,123.000000 20.500032,123.000000 20.000032,123.000000 20.000032,122.500000 20.000032,122.000000 20.000032,121.500000"},{"areaDesc":"巴士海峽西部","polygon":"20.000032,120.500000 20.000032,120.000000 20.500032,120.000000 21.000032,120.000000 21.500032,120.000000 22.000032,120.000000 22.000032,120.5