{"success":"true","result":{"resource_id":"W-C0033-002","fields":[{"id":"datasetDescription","type":"String"},{"id":"datasetLanguage","type":"String"},{"id":"issueTime","type":"Timestamp"},{"id":"startTime","type":"Timestamp"},{"id":"endTime","type":"Timestamp"},{"id":"update","type":"Timestamp"},{"id":"contentLanguage","type":"String"},{"id":"contentText","type":"String"},{"id":"language","type":"String"},{"id":"phenomena","type":"String"},{"id":"significance","type":"String"},{"id":"locationName","type":"String"}]},"records":{"record":[{"datasetInfo":{"datasetDescription":"陸上強風特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-10-21 16:32:00","endTime":"2026-10-22 23:00:00"},"issueTime":"2026-10-21 16:32:00","update":"2026-10-21 16:35:05"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                一、概述：颱風外圍環流影響及東北風明顯偏強，21日下午至22日晚上蘭嶼、綠島、臺中市、澎湖縣局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，基隆市、新北市、桃園市、新竹市、新竹縣、苗栗縣、彰化縣、雲林縣、嘉義縣、臺南市、屏東縣、宜蘭縣、花蓮縣、臺東縣、金門縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。\n\n二、注意(警戒)事項\n橙色燈號：警戒！應避免戶外活動，防範路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)因強風毀損倒塌而造成危害。避免行車，若於行車中，請尋找安全地點停車避風；留意大眾運輸停駛(飛)及國道與高架道路降速封閉訊息。\n黃色燈號：注意！在戶外請小心因強風造成路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)脫落或掉落；戶外工作者請注意安全；加強牢固戶外物品；行車減速慢行，留意大眾運輸延誤訊息。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"陸上強風","significance":"特報","affectedAreas":{"location":[{"locationName":"臺中市"},{"locationName":"蘭嶼綠島"},{"locationName":"澎湖縣"},{"locationName":"基隆北海岸"},{"locationName":"桃園市"},{"locationName":"新竹市"},{"locationName":"新竹縣"},{"locationName":"苗栗縣"},{"locationName":"彰化縣"},{"locationName":"雲林縣"},{"locationName":"嘉義縣"},{"locationName":"臺南市"},{"locationName":"恆春半島"},{"locationName":"臺東縣"},{"locationName":"花蓮縣"},{"locationName":"宜蘭縣"},{"locationName":"金門縣"},{"locationName":"連江縣"}]}}}]}}}]}}