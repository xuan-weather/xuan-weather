{"success":"true","result":{"resource_id":"W-C0033-002","fields":[{"id":"datasetDescription","type":"String"},{"id":"datasetLanguage","type":"String"},{"id":"issueTime","type":"Timestamp"},{"id":"startTime","type":"Timestamp"},{"id":"endTime","type":"Timestamp"},{"id":"update","type":"Timestamp"},{"id":"contentLanguage","type":"String"},{"id":"contentText","type":"String"},{"id":"language","type":"String"},{"id":"phenomena","type":"String"},{"id":"significance","type":"String"},{"id":"locationName","type":"String"}]},"records":{"record":[{"datasetInfo":{"datasetDescription":"陸上強風特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-10-09 10:36:00","endTime":"2026-10-10 23:00:00"},"issueTime":"2026-10-09 10:36:00","update":"2026-10-09 10:39:04"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                一、概述：東北風偏強，9日上午至10日晚上桃園市、新竹縣、苗栗縣、臺中市、彰化縣、屏東縣、臺東縣(含蘭嶼、綠島)、澎湖縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意。\n\n二、注意(警戒)事項\n黃色燈號：注意！在戶外請小心因強風造成路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)脫落或掉落；戶外工作者請注意安全；加強牢固戶外物品；行車減速慢行，留意大眾運輸延誤訊息。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"陸上強風","significance":"特報","affectedAreas":{"location":[{"locationName":"桃園市"},{"locationName":"新竹縣"},{"locationName":"苗栗縣"},{"locationName":"臺中市"},{"locationName":"彰化縣"},{"locationName":"恆春半島"},{"locationName":"蘭嶼綠島"},{"locationName":"臺東縣"},{"locationName":"澎湖縣"},{"locationName":"連江縣"}]}}}]}}}]}}