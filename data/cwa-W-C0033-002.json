{"success":"true","result":{"resource_id":"W-C0033-002","fields":[{"id":"datasetDescription","type":"String"},{"id":"datasetLanguage","type":"String"},{"id":"issueTime","type":"Timestamp"},{"id":"startTime","type":"Timestamp"},{"id":"endTime","type":"Timestamp"},{"id":"update","type":"Timestamp"},{"id":"contentLanguage","type":"String"},{"id":"contentText","type":"String"},{"id":"language","type":"String"},{"id":"phenomena","type":"String"},{"id":"significance","type":"String"},{"id":"locationName","type":"String"}]},"records":{"record":[{"datasetInfo":{"datasetDescription":"陸上強風特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-11-14 20:00:00","endTime":"2026-11-15 23:00:00"},"issueTime":"2026-11-14 16:24:00","update":"2026-11-14 18:59:50"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                一、概述：14日晚至15日晨鋒面通過，15日上午起東北風增強，桃園市、新竹縣、苗栗縣、臺中市、彰化縣、雲林縣、屏東縣、臺東縣(含綠島)、澎湖縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意。\n\n二、注意(警戒)事項\n黃色燈號：注意！在戶外請小心因強風造成路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)脫落或掉落；戶外工作者請注意安全；加強牢固戶外物品；行車減速慢行，留意大眾運輸延誤訊息。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"陸上強風","significance":"特報","affectedAreas":{"location":[{"locationName":"桃園市"},{"locationName":"新竹縣"},{"locationName":"苗栗縣"},{"locationName":"臺中市"},{"locationName":"彰化縣"},{"locationName":"雲林縣"},{"locationName":"恆春半島"},{"locationName":"蘭嶼綠島"},{"locationName":"臺東縣"},{"locationName":"澎湖縣"},{"locationName":"連江縣"}]}}}]}}},{"datasetInfo":{"datasetDescription":"豪雨特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-11-14 18:57:00","endTime":"2026-11-15 01:00:00"},"issueTime":"2026-11-14 18:55:00","update":"2026-11-14 18:59:50"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                鋒面通過，易有短延時強降雨，今(14)日高雄市有局部大雨或豪雨，屏東地區有局部大雨發生的機率，請注意雷擊及強陣風，低窪地區請慎防積水。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"豪雨","significance":"特報","affectedAreas":{"location