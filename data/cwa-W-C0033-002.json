{"success":"true","result":{"resource_id":"W-C0033-002","fields":[{"id":"datasetDescription","type":"String"},{"id":"datasetLanguage","type":"String"},{"id":"issueTime","type":"Timestamp"},{"id":"startTime","type":"Timestamp"},{"id":"endTime","type":"Timestamp"},{"id":"update","type":"Timestamp"},{"id":"contentLanguage","type":"String"},{"id":"contentText","type":"String"},{"id":"language","type":"String"},{"id":"phenomena","type":"String"},{"id":"significance","type":"String"},{"id":"locationName","type":"String"}]},"records":{"record":[{"datasetInfo":{"datasetDescription":"大雨特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-10-06 15:00:00","endTime":"2026-10-06 23:00:00"},"issueTime":"2026-10-06 15:00:00","update":"2026-10-06 15:02:55"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                午後對流雲系發展旺盛，易有短延時強降雨，今(6)日屏東地區及嘉義以南山區有局部大雨發生的機率，請注意，山區請慎防坍方及落石，低漥地區請慎防積水。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"大雨","significance":"特報","affectedAreas":{"location":[{"locationName":"嘉義縣山區"},{"locationName":"臺南市山區"},{"locationName":"高雄市山區"},{"locationName":"屏東縣"},{"locationName":"恆春半島"}]}}}]}}},{"datasetInfo":{"datasetDescription":"陸上強風特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-10-06 10:39:00","endTime":"2026-10-07 23:00:00"},"issueTime":"2026-10-06 10:40:00","update":"2026-10-06 15:02:55"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                一、概述：東北風明顯偏強，6日上午至7日晚上屏東縣局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，桃園市、新竹市、新竹縣、苗栗縣、臺中市、彰化縣、雲林縣、嘉義縣、臺南市、臺東縣(含蘭嶼、綠島)、澎湖縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。\n\n二、注意(警戒)事項\n橙色燈號：警戒！應避免戶外活動，防範路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)因強風毀損倒塌而造成危害。避免行車，若於行車中，請尋找安全地點停車避風；留意大眾運輸停駛(飛)及國道與高架道路降速封閉訊息。\n黃色燈號：注意！在戶外請小心因強風造成路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)脫落或掉落；戶外工作者請注意安全；加強牢固戶外物品；行車減速慢行，留意大眾運輸延誤訊息。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"陸上強風","significance":"特報","affectedAreas":{"location":[{"locationName":"恆春半島"},{"locationName":"桃園市"},{"locationName":"新竹市"},{"locationName":"新竹縣"},{"locationName":"苗栗縣"},{"locationName":"臺中市"},{"locationName":"彰化縣"},{"locationName":"雲林縣"},{"locationName":"嘉義縣"},{"locationName":"臺南市"},{"locationName":"屏東縣"},{"locationName":"蘭嶼綠島"},{"locationName":"臺東縣"},{"locationName":"澎湖縣"},{"locationName":"連江縣"}]}}}]}}}]}}