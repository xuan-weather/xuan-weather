{"success":"true","result":{"resource_id":"W-C0033-002","fields":[{"id":"datasetDescription","type":"String"},{"id":"datasetLanguage","type":"String"},{"id":"issueTime","type":"Timestamp"},{"id":"startTime","type":"Timestamp"},{"id":"endTime","type":"Timestamp"},{"id":"update","type":"Timestamp"},{"id":"contentLanguage","type":"String"},{"id":"contentText","type":"String"},{"id":"language","type":"String"},{"id":"phenomena","type":"String"},{"id":"significance","type":"String"},{"id":"locationName","type":"String"}]},"records":{"record":[{"datasetInfo":{"datasetDescription":"陸上強風特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-10-05 16:35:00","endTime":"2026-10-06 23:00:00"},"issueTime":"2026-10-05 16:35:00","update":"2026-10-05 22:28:54"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                一、概述：東北風偏強，5日下午至6日晚上新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、彰化縣、雲林縣、嘉義縣、臺南市、屏東縣、宜蘭縣、臺東縣(含蘭嶼、綠島)、澎湖縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意。\n\n二、注意(警戒)事項\n黃色燈號：注意！在戶外請小心因強風造成路樹、不堅固建築或定置物(如鐵皮屋、貨櫃及電線桿等)脫落或掉落；戶外工作者請注意安全；加強牢固戶外物品；行車減速慢行，留意大眾運輸延誤訊息。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"陸上強風","significance":"特報","affectedAreas":{"location":[{"locationName":"基隆北海岸"},{"locationName":"桃園市"},{"locationName":"新竹市"},{"locationName":"新竹縣"},{"locationName":"苗栗縣"},{"locationName":"臺中市"},{"locationName":"彰化縣"},{"locationName":"雲林縣"},{"locationName":"嘉義縣"},{"locationName":"臺南市"},{"locationName":"恆春半島"},{"locationName":"屏東縣"},{"locationName":"蘭嶼綠島"},{"locationName":"臺東縣"},{"locationName":"宜蘭縣"},{"locationName":"澎湖縣"},{"locationName":"連江縣"}]}}}]}}},{"datasetInfo":{"datasetDescription":"大雨特報","datasetLanguage":"zh-TW","validTime":{"startTime":"2026-10-05 19:30:00","endTime":"2026-10-06 00:00:00"},"issueTime":"2026-10-05 19:30:00","update":"2026-10-05 22:28:54"},"contents":{"content":{"contentLanguage":"zh-TW","contentText":"\n                東北季風影響，易有短延時強降雨，今(5)日基隆北海岸、宜蘭地區及大臺北山區有局部大雨發生的機率；對流雲系發展旺盛，易有短延時強降雨，屏東及臺東地區亦有局部大雨發生的機率，請注意雷擊及強陣風，山區請慎防坍方、落石及溪水暴漲，低窪地區請慎防積水。\n                "}},"hazardConditions":{"hazards":{"hazard":[{"info":{"language":"zh-TW","phenomena":"大雨","significance":"特報","affectedAreas":{"location":[{"locationName":"基隆市"},{"locationName":"北海岸"},{"locationName":"臺北市山區"},{"locationName":"新北市山區"},{"locationName":"屏東縣"},{"locationName":"恆春半島"},{"locationName":"宜蘭縣"},{"locationName":"臺東縣"}]}}}]}}}]}}